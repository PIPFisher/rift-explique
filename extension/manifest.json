{
  "manifest_version": 3,
  "name": "Riftbound en français",
  "version": "1.1.0",
  "description": "Affiche la traduction française des cartes Riftbound au survol, sur Rift Atlas et dans le simulateur.",
  "content_scripts": [
    {
      "matches": [
        "https://riftatlas.com/*",
        "https://www.riftatlas.com/*",
        "https://play.riftatlas.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fr.json"
      ],
      "matches": [
        "https://riftatlas.com/*",
        "https://www.riftatlas.com/*",
        "https://play.riftatlas.com/*"
      ]
    }
  ],
  "host_permissions": [
    "https://pipfisher.github.io/*"
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Riftbound en français"
  }
}