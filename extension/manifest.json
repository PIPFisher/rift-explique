{
  "manifest_version": 3,
  "name": "Riftbound en français",
  "version": "1.14.0",
  "description": "Traduction francaise des cartes Riftbound au survol, sur Rift Atlas et dans le simulateur. Terminologie officielle VF, mots-cles au code couleur du jeu.",
  "content_scripts": [
    {
      "matches": [
        "https://riftatlas.com/*",
        "https://www.riftatlas.com/*",
        "https://play.riftatlas.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fr.json"
      ],
      "matches": [
        "https://riftatlas.com/*",
        "https://www.riftatlas.com/*",
        "https://play.riftatlas.com/*"
      ]
    }
  ],
  "host_permissions": [
    "https://pipfisher.github.io/*",
    "https://riftatlas.com/*",
    "https://www.riftatlas.com/*",
    "https://play.riftatlas.com/*"
  ],
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "action": {
    "default_title": "Riftbound en français"
  },
  "background": {
    "service_worker": "background.js"
  }
}
